# ---------------------------------------------------------------------------
# Environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored: secrets must never be committed to version control.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Comma separated list, or * to allow any origin
CORS_ORIGIN=*

# JWT - generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
JWT_EXPIRES_IN=1h
JWT_ISSUER=school-management-system
JWT_AUDIENCE=school-management-api

# Password hashing (bcrypt cost factor - 10-12 recommended for production)
BCRYPT_SALT_ROUNDS=10

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72

# Rate limiting
# Auth endpoints (register + login) - brute force protection
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Global limit applied to every request
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# Login attempts only (failures) - credential stuffing protection
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Seed / bootstrap administrator (created on first boot if no admin exists)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@school.test
ADMIN_PASSWORD=Admin@12345

# Number of records auto-generated for students, teachers, classes, subjects, results
SEED_STUDENTS=6
SEED_TEACHERS=4
SEED_CLASSES=4
SEED_SUBJECTS=8
SEED_RESULTS=30

# Set to false to start with an empty database
SEED_DATA=true

# Logging
# LOG_FORMAT=dev           # dev | combined | tiny  (request log layout)
# LOG_LEVEL=info           # error | warn | info | debug (verbosity)
# LOG_SILENT=false         # true silences all logging
LOG_SILENT=false

# Maximum accepted request body size
JSON_BODY_LIMIT=20kb

# Number of reverse proxies in front of the app (needed for correct client IPs
# when rate limiting behind a load balancer). 0 for direct/local access.
TRUST_PROXY_HOPS=0
